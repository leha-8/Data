# ==============================================================================
# SOAR INTEGRATION ENVIRONMENT CONFIGURATION (.env)
# Sao chép file này thành '.env' và điền các thông tin xác thực bảo mật của bạn.
# ==============================================================================

# 1. Cấu hình Webhook Service
APP_NAME="SOAR Webhook Receiver"
HOST="0.0.0.0"
PORT=8000
# Khóa bí mật dùng để xác thực webhook (tùy chọn nhưng khuyến nghị dùng trong production):
# Header yêu cầu: X-Webhook-Secret: YourSecretTokenHere
WEBHOOK_SECRET="change-this-secret-token-123456"
DEBUG=false

# 2. Ngưỡng cảnh báo từ SIEM
# Wazuh rule level (Thang điểm 0 - 16, mặc định >= 7 được xếp loại High/Critical)
WAZUH_MIN_LEVEL=7

# 3. Cấu hình tích hợp GitHub API & GitHub Actions
# GitHub Personal Access Token (PAT) có quyền 'repo' và 'workflow'
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Repository GitHub quản lý Incident (dạng: owner/repo)
GITHUB_REPOSITORY="leha-8/Data"
# Danh sách tài khoản SOC phụ trách xử lý sự cố (phân cách bằng dấu phẩy)
GITHUB_SOC_ASSIGNEES="leha-8"
# Tên file workflow cô lập mạng
GITHUB_WORKFLOW_FILE="isolate-host.yml"
GITHUB_WORKFLOW_REF="main"

# 4. Cấu hình thiết bị Ruijie Switch / Gateway (RGOS)
RUIJIE_HOST="192.168.1.2"
RUIJIE_USERNAME="admin"
RUIJIE_PASSWORD="RuijiePassword123"
# Mật khẩu chế độ Enable (Privileged EXEC mode) của Ruijie nếu có
RUIJIE_SECRET="RuijieEnableSecret123"
RUIJIE_SSH_PORT=22
# Tên Access-List mở rộng áp dụng chặn IP
RUIJIE_ACL_NAME="ACL_SOAR_BLOCK"
# Interface mạng hoặc VLAN áp dụng ACL
RUIJIE_VLAN_INTERFACE="GigabitEthernet 0/1"

# 5. Cấu hình DrayTek Vigor Router (VigorOS)
DRAYTEK_HOST="192.168.1.1"
DRAYTEK_USERNAME="admin"
DRAYTEK_PASSWORD="DrayTekPassword123"
DRAYTEK_SSH_PORT=22
# Bộ lọc Firewall Data Filter Set và Rule trên Vigor
DRAYTEK_FILTER_SET=2
DRAYTEK_FILTER_RULE=2

# 6. Thiết lập hành vi xử lý sự cố
# Thiết bị mục tiêu mặc định khi kích hoạt tự động: 'all', 'ruijie', hoặc 'draytek'
DEFAULT_DEVICE_TARGET="all"
# Chế độ Dry-Run: 'true' để mô phỏng sinh lệnh mà không can thiệp phần cứng thật
DRY_RUN=false
