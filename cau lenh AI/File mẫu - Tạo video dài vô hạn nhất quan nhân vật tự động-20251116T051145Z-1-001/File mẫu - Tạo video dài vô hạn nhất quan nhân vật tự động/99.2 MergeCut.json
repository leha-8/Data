      "parameters": {
        "language": "python",
        "pythonCode": "# Access the input data from the previous node\n# Assuming the input is a single item with a 'video_urls' key\nvideo_urls = items[0]['json']['video_urls']\n\nclips = []\n\nfor index, url in enumerate(video_urls):\n    clip = {\n        \"asset\": {\n            \"type\": \"video\",\n            \"src\": url,\n            \"trim\": 1  # Adds the 0.3 second trim to each video\n        },\n        # For sequential playback on the same track, the first clip starts at 0,\n        # and subsequent clips are automatically placed after the previous one using \"auto\".\n        \"start\": \"auto\" if index > 0 else 0,\n        \"length\": \"auto\" # 'auto' uses the full trimmed length of the asset\n    }\n    clips.append(clip)\n\n# Return the generated clips array as the output of this node\nreturn [{\"clips\": clips}]\n"
      },
